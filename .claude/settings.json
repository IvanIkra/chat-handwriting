{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git branch:*)",
      "Bash(git push --force-with-lease origin:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push --force-with-lease origin HEAD:main:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Edit(./**/.env)",
      "Bash(cat .env:*)"
    ]
  }
}
